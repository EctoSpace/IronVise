# =============================================================================
#  IronVise - Environment Variable Reference
#  Copy this file to .env and customise for your setup.
#    cp .env.example .env
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres (default). pg-embed starts an embedded instance automatically
# when nothing is running on localhost:5432 - no external DB needed for dev.
DATABASE_URL=postgres://ectoledger:ectoledger@localhost:5432/ectoledger

# SQLite (for ephemeral local dev or CI - fully self-contained):
# DATABASE_URL=sqlite://ledger.db

# External Docker Postgres (e.g. for staging):
# DATABASE_URL=postgres://user:password@db-host:5432/ectoledger_prod

# Developer/test mode. Required for DATABASE_URL to fall back to the default dev
# credentials shown above when unset; production must set DATABASE_URL explicitly.
# ECTO_DEV_MODE=true

# Connection pool size. Default: 2 × CPU count, clamped to [5, 50].
# DATABASE_POOL_SIZE=10

# ── LLM provider ──────────────────────────────────────────────────────────────
# Presets: ollama | lmstudio | llamacpp | vllm | mlx | localai
#          openai | anthropic | gemini | azure-openai | mistral | groq
#          openrouter | deepseek | xai | openai-compatible
#
# All of these except ollama and anthropic speak the same OpenAI-compatible
# wire format on their own port, so they share one code path. A preset only
# supplies defaults; OPENAI_BASE_URL and OPENAI_MODEL still override.
#
# Not listed and still supported: anything else speaking that format. Use
# openai-compatible with its base URL. A preset would only add a default port.
LLM_PROVIDER=ollama

# DEPRECATED: LLM_BACKEND is still read as an alias so existing .env files keep
# working, and it warns once at startup. When both are set, LLM_PROVIDER wins.
# LLM_BACKEND=ollama

# Ollama (LLM_PROVIDER=ollama) - the one exception: it uses its own native
# /api/chat protocol rather than the OpenAI shape.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral

# OpenAI-compatible servers (lmstudio, llamacpp, vllm, mlx, localai,
# openai-compatible) and OpenAI itself all read these.
#
# OPENAI_BASE_URL accepts the URL the server prints for you, with or without
# the trailing /v1 - both forms work. Appending /v1 twice used to 404; that is
# fixed, but the tolerance is deliberate because every server states it
# differently.
#   LM Studio       http://127.0.0.1:1234/v1
#   llama.cpp       http://127.0.0.1:8080/v1
#   vLLM            http://127.0.0.1:8000/v1
#   MLX-LM          http://127.0.0.1:8080/v1
#   OpenAI          https://api.openai.com/v1
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_MODEL default when unset is gpt-6-astra
# OPENAI_MODEL=gpt-6-luna
# Local servers often want any non-empty key; OpenAI wants a real one.
# OPENAI_API_KEY=sk-...

# Hosted OpenAI-compatible providers read their own key (docs/guides/configuration.md,
# "Hosted providers"). Azure needs its resource URL and deployment name, xAI a
# model name:
# GEMINI_API_KEY=...        MISTRAL_API_KEY=...      GROQ_API_KEY=...
# OPENROUTER_API_KEY=...    DEEPSEEK_API_KEY=...     XAI_API_KEY=...
# AZURE_OPENAI_API_KEY=...  (with OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1
#                            and OPENAI_MODEL=<deployment>)

# Anthropic settings (LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL default when unset is claude-opus-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Override the API base URL (default https://api.anthropic.com)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Total per-request HTTP timeout (seconds) for every LLM call - the primary
# backend and the Guard backend alike, since they share one reqwest::Client.
# Default 300s is sized for a large local Ollama model under load; the old
# hard-coded 60s failed every call to a 26B model with "error sending request
# for url (...)". 0, negative and non-numeric values are rejected and fall
# back to the default.
# ECTO_LLM_TIMEOUT_SECS=300

# ── Declarative policy ───────────────────────────────────────────────────────
# Path to the server-wide audit_policy.toml. When set, the policy layer applies
# to the Claude Code hook, the SDK verify-intent endpoint and the REST run path
# alike; when unset there is no policy layer and every verdict reports it as
# skipped. A path that does not load fails startup.
# ECTO_POLICY_PATH=./audit_policy.toml

# ── Guard (Policy Enforcement LLM) ───────────────────────────────────────────
# GUARD_REQUIRED defaults to true. Disable ONLY for local development
# when no guard LLM is configured. Resolved most-restrictive-wins against
# .ectoledger/settings.json: if either source requires the guard, it is
# required. See docs/guides/configuration.md.
GUARD_REQUIRED=true

# Required when GUARD_REQUIRED=true:
# GUARD_LLM_BACKEND=ollama
# GUARD_LLM_MODEL=llama3.2

# ── Agent Behaviour ────────────────────────────────────────────────────────────
# Max number of cognitive loop steps per audit run
AGENT_MAX_STEPS=20

# Steps between automatic ledger snapshots
AGENT_SNAPSHOT_INTERVAL=50

# Consecutive LLM errors before the agent aborts
AGENT_LLM_ERROR_LIMIT=5

# Consecutive guard denials before the agent aborts
AGENT_GUARD_DENIAL_LIMIT=3

# Comma-separated allowlist of outbound domains for http_get actions.
# IMPORTANT: an empty/unset allowlist BLOCKS every http_get - you must list
# the domains you want to permit explicitly.
# AGENT_ALLOWED_DOMAINS=api.openai.com,api.anthropic.com

# Consecutive schema failures (missing/too-short justification) before aborting (default 3)
# AGENT_JUSTIFICATION_FAILURE_LIMIT=3

# Cumulative approximate token budget per run before aborting (default: unlimited)
# AGENT_TOKEN_BUDGET_MAX=1000000

# Rotate the session signing key every N agent steps (default: disabled)
# AGENT_KEY_ROTATION_STEPS=50

# Output scanner sensitivity for detecting secrets/PII: low | medium | high (default medium)
# SCANNER_SENSITIVITY=medium

# ── Server Binding ─────────────────────────────────────────────────────────────
# Interface the HTTP server binds to (default 127.0.0.1 - loopback only).
# Set to 0.0.0.0 to expose on all interfaces; the Bearer token then becomes the
# only access control, so front the server with TLS/reverse proxy if you do.
# ECTO_BIND_HOST=127.0.0.1
# Port the HTTP server binds to (default 3000)
# ECTO_BIND_PORT=3000
# Extra origins allowed by the Observer API CORS allowlist (comma-separated).
# Tauri webview + local Vite dev server origins are always allowed.
# ECTO_CORS_ALLOWED_ORIGINS=

# Reverse-proxy addresses allowed to set the rate-limiting client IP via the
# X-Forwarded-For / X-Real-Ip / Forwarded headers (comma-separated IPs or
# CIDRs, e.g. 127.0.0.1,10.0.0.0/8). Default empty: these headers are never
# trusted and the TCP socket peer is always the rate-limit key, so a direct
# caller cannot evade its own limit by spoofing a fresh header per request.
# Set this to your reverse proxy's address only if you front the server
# with one.
# ECTO_TRUSTED_PROXIES=

# ── Sandbox Failure Policy ─────────────────────────────────────────────────────
# Default false: if OS-level sandboxing (Landlock/Seatbelt) or a configured
# isolation tier (Firecracker/Docker) fails, the action is ABORTED (fail-closed).
# Set true only in development to permit degraded, less-isolated execution.
# ECTO_SANDBOX_PERMISSIVE=false

# ── Security & Signing ─────────────────────────────────────────────────────────
# Directory where session Ed25519 key files are stored
ECTO_DATA_DIR=.ectoledger

# Bearer token for the Observer dashboard (auto-generated and printed on startup if unset)
# OBSERVER_TOKEN=your-secret-token

# Passphrase for the encrypted session key file.
# DEPRECATED: prefer the interactive prompt.
# ECTO_KEY_PASSWORD=your-key-passphrase

# ── Webhooks / SIEM Egress ────────────────────────────────────────────────────
# Uncomment to enable webhook egress for audit events
# WEBHOOK_URL=https://your-siem-endpoint.example.com/events
# WEBHOOK_BEARER_TOKEN=your-webhook-bearer-token
# SIEM_FORMAT=json  # Options: json | cef | leef

# Include guard denial events in webhook egress
# WEBHOOK_INCLUDE_GUARD=true

# Include tripwire rejection events in webhook egress
# WEBHOOK_INCLUDE_TRIPWIRE=true

# HMAC secret used to sign each POST. Default: signing disabled.
# When set, each POST carries X-EctoLedger-Delivery, X-EctoLedger-Timestamp
# and X-EctoLedger-Signature-V1 (HMAC over id, timestamp, receiver URL and body,
# under a key derived for that receiver).
# WEBHOOK_HMAC_SECRET=your-hmac-secret
# Give each receiver only its own key: ironvise webhook-key --url <receiver url>
# WEBHOOK_LEGACY_SIGNATURE=false   # true also sends the replayable pre-0.8
# X-EctoLedger-Signature: sha256=<hex> header

# Max webhook deliveries per second per URL (default 10)
# WEBHOOK_RATE_LIMIT_PER_SECOND=10

# ── Logging ────────────────────────────────────────────────────────────────────
# Rust tracing log levels: error | warn | info | debug | trace
RUST_LOG=info

# ── Cloud Credentials (Ephemeral) ──────────────────────────────────────────────
# Path to a JSON file containing short-lived cloud credentials for the agent
# AGENT_CLOUD_CREDS_FILE=/tmp/ectoledger-cloud-creds.json

# ── Firecracker microVM Sandbox (Linux + KVM, `--features sandbox-firecracker`) ─
# Path to the firecracker binary enables the microVM sandbox (opt-in).
# ECTO_FC_BINARY=/usr/local/bin/firecracker
# Hard timeout for microVM execution in seconds (default 30)
# ECTO_FC_TIMEOUT_SECS=30
