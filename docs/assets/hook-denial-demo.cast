{"version": 2, "width": 100, "height": 34, "timestamp": 1794236645, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}}
[0.618472, "o", "\r\n\u001b[1m▸ Start IronVise on a fresh SQLite ledger\u001b[0m\r\n"]
[1.126646, "o", "\u001b[2m  $ ironvise serve\u001b[0m\r\n"]
[2.991721, "o", "\u001b[32m  ✓ listening on 127.0.0.1:3140\u001b[0m\r\n"]
[4.409006, "o", "\r\n\u001b[1m▸ Claude Code asks to run a harmless command\u001b[0m\r\n"]
[4.924339, "o", "\u001b[2m  $ ironvise hook   <<< {\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"ls -la\"}}\u001b[0m\r\n"]
[5.673187, "o", "\u001b[2m    (no output)\u001b[0m\r\n"]
[5.673345, "o", "\u001b[32m  ✓ no objection - recorded, and left to Claude Code's own permissions\u001b[0m\r\n"]
[7.090248, "o", "\r\n\u001b[1m▸ Now it asks to run something destructive\u001b[0m\r\n"]
[7.600849, "o", "\u001b[2m  $ ironvise hook   <<< {\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"rm -rf /\"}}\u001b[0m\r\n"]
[8.353967, "o", "    {\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\r\n        \"permissionDecisionReason\":\"banned command: rm -rf / (refused at the tripwire stage)\"}}\r\n"]
[8.358182, "o", "\u001b[32m  ✓ DENIED before execution - Claude Code honours this and does not run it\u001b[0m\r\n"]
[9.779796, "o", "\r\n\u001b[1m▸ The refusal is a first-class ledger event, not a log line\u001b[0m\r\n"]
[10.287831, "o", "\u001b[2m  $ sqlite3 ledger.sqlite 'SELECT sequence, payload FROM agent_events'\u001b[0m\r\n"]
[11.015879, "o", "╭───────────────────────────────────────────────────────╮\r\n│                 '    ' || sequenc...                  │\r\n╞═══════════════════════════════════════════════════════╡\r\n│ '    0  genesis'                                      │\r\n│ '    1  action'                                       │\r\n│ '    2  tripwire_rejection  banned command: rm -rf /' │\r\n╰───────────────────────────────────────────────────────╯\r\n"]
[11.027497, "o", "\u001b[32m  ✓ recorded as tripwire_rejection with enforced=true - the action did not happen\u001b[0m\r\n"]
[12.448492, "o", "\r\n\u001b[1m▸ Verify the session\u001b[0m\r\n"]
[12.978599, "o", "\u001b[2m  $ ironvise verify-session 96e81c4b-c012-4324-9d07-704d2f8bd331\u001b[0m\r\n"]
[13.72193, "o", "    All 2 event signatures verified for session 96e81c4b-c012-4324-9d07-704d2f8bd331.\r\n"]
[13.722515, "o", "\u001b[32m  ✓ signatures verified\u001b[0m\r\n"]
[15.138749, "o", "\r\n\u001b[1m▸ Now change one byte in the ledger, as an attacker with database access would\u001b[0m\r\n"]
[15.649854, "o", "\u001b[2m  $ sqlite3 ledger.sqlite 'UPDATE agent_events SET payload = ... WHERE sequence = 2'\u001b[0m\r\n"]
[16.387644, "o", "\u001b[32m  ✓ the recorded reason for the denial now reads \"looked fine to me\"\u001b[0m\r\n"]
[17.802929, "o", "\r\n\u001b[1m▸ Verify again\u001b[0m\r\n"]
[18.313591, "o", "\u001b[2m  $ ironvise verify-session 96e81c4b-c012-4324-9d07-704d2f8bd331\u001b[0m\r\n"]
[19.051666, "o", "    Error: Ledger chain verification failed: tampering detected.\r\n"]
[19.052096, "o", "\u001b[32m  ✓ tampering detected\u001b[0m\r\n"]
[19.893474, "o", "\r\n\u001b[1mThe point:\u001b[0m\r\n"]
[19.896269, "o", "    The command was refused before it ran, the refusal is in the chain as\r\n    structured evidence, and altering that evidence afterwards is detectable\r\n    by anyone holding the ledger.\r\n\r\n    What this does NOT show: that the log is complete. A hash chain constrains\r\n    what can happen after an event is written. It says nothing about an event\r\n    that was never written.\r\n"]
