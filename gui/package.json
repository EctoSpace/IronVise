{
  "name": "ironvise-gui",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 1420",
    "build": "vite build",
    "icon:generate": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run test:unit && npm run test:dependencies",
    "test:unit": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:dependencies": "node --test scripts/deepmerge-security.test.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "bits-ui": "^2.16.2",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "jsdom": "^29.1.1",
    "shadcn-svelte": "^1.1.1",
    "sharp": "^0.35.3",
    "svelte": "^5",
    "svelte-check": "^4",
    "tailwindcss": "^4.2.1",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "deepmerge": "file:security-deps-deepmerge"
  },
  "optionalDependencies": {
    "@rolldown/binding-android-arm-eabi": "1.2.15",
    "@rolldown/binding-android-arm64": "1.2.15",
    "@rolldown/binding-darwin-arm64": "1.2.15",
    "@rolldown/binding-darwin-x64": "1.2.15",
    "@rolldown/binding-freebsd-x64": "1.2.15",
    "@rolldown/binding-linux-arm-gnueabihf": "1.2.15",
    "@rolldown/binding-linux-arm64-gnu": "1.2.15",
    "@rolldown/binding-linux-arm64-musl": "1.2.15",
    "@rolldown/binding-linux-ppc64-gnu": "1.2.15",
    "@rolldown/binding-linux-s390x-gnu": "1.2.15",
    "@rolldown/binding-linux-x64-gnu": "1.2.15",
    "@rolldown/binding-linux-x64-musl": "1.2.15",
    "@rolldown/binding-openharmony-arm64": "1.2.15",
    "@rolldown/binding-win32-arm64-msvc": "1.2.15",
    "@rolldown/binding-win32-x64-msvc": "1.2.15"
  },
  "overrides": {
    "deepmerge": "$deepmerge"
  }
}
