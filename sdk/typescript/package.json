{
  "name": "ironvise",
  "version": "0.8.0",
  "homepage": "https://ectospace.com/EctoLedger",
  "description": "AI firewall and hash-chained, signed audit trail for AI agents. TypeScript SDK for IronVise.",
  "license": "Apache-2.0",
  "author": "Björn Roman Kohlberger <ironvise@ectospace.com>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node esbuild.mjs",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "test:pack": "node scripts/test-pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EctoSpace/EctoLedger.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/EctoSpace/EctoLedger/issues"
  },
  "keywords": [
    "ironvise",
    "ai",
    "governance",
    "audit",
    "ledger",
    "compliance"
  ]
}
